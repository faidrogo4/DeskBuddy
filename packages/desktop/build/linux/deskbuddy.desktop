[Desktop Entry]
Name=DeskBuddy
Comment=Next generation markdown editor
Exec=deskbuddy %F
Terminal=false
Type=Application
Icon=deskbuddy
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=deskbuddy;
StartupWMClass=deskbuddy
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=deskbuddy --new-window %F
Icon=deskbuddy
